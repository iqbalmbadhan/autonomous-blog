# Copy this file to .env and fill in your values:  cp .env.example .env
# Never commit .env — it is ignored by .gitignore.

# Groq (outline) — free key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (article) — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-3.8-flash

# Pollinations AI (featured image) — free key: https://enter.pollinations.ai
POLLINATIONS_API_KEY=
# Optional: override the image endpoint (default: https://gen.pollinations.ai/image)
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai/image

# WordPress REST API
# Full posts endpoint of your site
WP_URL=https://yourdomain.com/wp-json/wp/v2/posts
# Your WordPress username (not your email, unless you log in with it)
WP_USER=
# Application Password: WP Admin -> Users -> Profile -> Application Passwords
WP_APP_PASS=
